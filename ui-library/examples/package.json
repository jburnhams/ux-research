{
  "name": "strata-examples",
  "private": true,
  "type": "module",
  "description": "Worked example for ui-library/: the kiln room at a fictional pottery co-op, built on strata-react with its own generated theme.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i app/globals.css -o dist/tailwind.css",
    "lint": "node ../../ux-design/skill/scripts/slop-lint.mjs .",
    "render": "node scripts/render.mjs",
    "site": "node scripts/build-site.mjs",
    "check": "npm run typecheck && npm run css && npm run lint"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.2.0",
    "@tanstack/react-query": "^5.107.1",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "strata-react": "^0.1.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
